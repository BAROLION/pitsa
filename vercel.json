{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix mini-app --include=dev",
  "buildCommand": "npm run build --prefix mini-app",
  "outputDirectory": "mini-app/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pitsa-1uvp.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
