generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  KUTILMOQDA
  YOLDA
  YETKAZILDI
  BEKOR_QILINDI
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  name       String
  phone      String?
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@map("users")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  ingredients String[] @default([])
  imageUrl    String
  oldPrice    Int      @default(0)
  newPrice    Int
  category    String   @default("Pizza")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json
  total     Int
  location  String
  phone     String?
  comment   String?
  status    OrderStatus @default(KUTILMOQDA)

  // Kuryer va yetkazish vaqti
  courierName  String?
  courierPhone String?
  pickedUpAt   DateTime? // kuryer buyurtmani olgan vaqt
  etaAt        DateTime? // taxminiy yetib borish vaqti
  deliveredAt  DateTime? // haqiqatda yetkazilgan vaqt

  // Kuryerni jonli kuzatish (Telegram "Live Location")
  courierToken  String?   @unique // kuryer havolasi uchun maxfiy kalit (mijozga ko'rsatilmaydi)
  courierChatId String? // havolani ochgan kuryerning Telegram ID'si
  courierLat    Float?
  courierLng    Float?
  courierLocAt  DateTime? // oxirgi joylashuv vaqti

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([courierChatId])
  @@map("orders")
}
